{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["helpers:pinGitHubActionDigests"],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "commitMessagePrefix": "⬆️",
  "commitMessageTopic": "{{depName}}",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "\\s\\s(?<package>[a-z0-9][a-z0-9.+-]+)=(?<currentValue>[a-z0-9-:_+~.]+)\\s+"
      ],
      "versioningTemplate": "deb",
      "datasourceTemplate": "deb",
      "depNameTemplate": "{{{package}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Ubuntu 26.04 packages of the app image",
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://archive.ubuntu.com/ubuntu?suite=resolute&components=main,restricted,universe,multiverse&binaryArch=amd64",
        "https://archive.ubuntu.com/ubuntu?suite=resolute-updates&components=main,restricted,universe,multiverse&binaryArch=amd64",
        "https://security.ubuntu.com/ubuntu?suite=resolute-security&components=main,restricted,universe,multiverse&binaryArch=amd64"
      ],
      "automerge": true
    },
    {
      "description": "Final Ubuntu 18.04 pins of the EOL MongoDB build stage",
      "matchDatasources": ["deb"],
      "matchDepNames": [
        "ca-certificates",
        "curl",
        "libcurl4",
        "libssl1.0.0",
        "libssl1.1"
      ],
      "matchCurrentValue": "/^(20230311ubuntu0\\.18\\.04\\.1|7\\.58\\.0-2ubuntu3\\.24|1\\.0\\.2n-1ubuntu5\\.13|1\\.1\\.1-1ubuntu2\\.1~18\\.04\\.23)$/",
      "enabled": false
    },
    {
      "groupName": "App base image",
      "matchDatasources": ["docker"],
      "matchDepNames": ["ubuntu"],
      "matchCurrentValue": "26.04"
    },
    {
      "description": "Legacy MongoDB 3.6 runtime source and the EOL MongoDB build stage are pinned on purpose",
      "matchDatasources": ["docker"],
      "matchDepNames": ["ghcr.io/hassio-addons/unifi", "ubuntu"],
      "matchCurrentValue": "/^(5\\.3\\.2|18\\.04)$/",
      "enabled": false
    }
  ]
}
